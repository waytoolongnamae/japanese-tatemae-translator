# DeepSeek API Configuration
DEEPSEEK_API_KEY_CHAT=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4

# Model Configuration
MODEL_PROVIDER=deepseek  # Options: "deepseek" or "openai"
DEFAULT_MODEL=deepseek-chat
TEMPERATURE=0.7
API_TIMEOUT_SECONDS=30
MAX_API_RETRIES=3

# Log Level
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_TO_FILE=true
LOG_FILE_NAME=translator.log
LOG_FILE_MAX_BYTES=5242880
LOG_FILE_BACKUPS=5

# Request/Validation Limits
MIN_INPUT_LENGTH=1
MAX_INPUT_LENGTH=5000
MAX_REQUEST_BYTES=65536

# Web Security/Network Configuration (comma-separated)
ALLOWED_HOSTS=
CORS_ALLOWED_ORIGINS=
